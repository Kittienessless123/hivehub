# ============ DATABASE CONFIGURATION ============
# Auth Service Database
POSTGRES_AUTH_HOST=postgres-auth
POSTGRES_AUTH_PORT=5432
POSTGRES_AUTH_DB=auth_db
POSTGRES_AUTH_USER=hivehub
POSTGRES_AUTH_PASSWORD=secure_password_here

# User Service Database
POSTGRES_USER_HOST=postgres-user
POSTGRES_USER_PORT=5432
POSTGRES_USER_DB=user_db
POSTGRES_USER_USER=hivehub
POSTGRES_USER_PASSWORD=secure_password_here

# Main Database (for other services)
POSTGRES_HOST=postgres-main
POSTGRES_PORT=5432
POSTGRES_DB=main_db
POSTGRES_USER=hivehub
POSTGRES_PASSWORD=secure_password_here

# ============ REDIS CONFIGURATION ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_here

# ============ RABBITMQ CONFIGURATION ============
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=rabbitmq_password_here
RABBITMQ_QUEUE_PREFIX=hivehub

# ============ JWT CONFIGURATION ============
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ============ API GATEWAY ============
API_GATEWAY_PORT=3000
API_GATEWAY_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ============ MICROSERVICES PORTS ============
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
WORKSPACE_SERVICE_PORT=3003
PROJECT_SERVICE_PORT=3004
PAYMENT_SERVICE_PORT=3005
NOTIFICATION_SERVICE_PORT=3006
CHAT_SERVICE_PORT=3007
ANALYTICS_SERVICE_PORT=3008
AI_SERVICE_PORT=3009
STORAGE_SERVICE_PORT=3010
ADMIN_SERVICE_PORT=3011

# ============ EMAIL CONFIGURATION ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
EMAIL_FROM=noreply@hivehub.com

# ============ PAYMENT PROVIDERS ============
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=test_your_yookassa_key

# ============ AI SERVICES ============
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ORGANIZATION=org-your-org-id

# ============ STORAGE (S3/MinIO) ============
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=hivehub-storage
AWS_S3_REGION=us-east-1
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ============ MONITORING ============
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_HOST=jaeger
JAEGER_PORT=6832

# ============ FRONTEND ============
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000

# ============ APPLICATION ============
NODE_ENV=development
LOG_LEVEL=debug
API_RATE_LIMIT=100
API_RATE_TTL=60

# ============ SECURITY ============
COOKIE_SECRET=cookie_secret_here
SESSION_SECRET=session_secret_here
CRYPTO_SECRET_KEY=32_char_secret_for_encryption