FROM node:22-alpine

WORKDIR /app

# Копируем зависимости и устанавливаем ВСЕ (включая dev)
COPY package*.json ./
RUN npm ci

# Копируем всё остальное
COPY . .

# Устанавливаем глобально nodemon для лучшего hot-reload (опционально)
RUN npm install -g nodemon

EXPOSE 3000

# Используем nodemon для hot-reload
CMD ["npm", "run", "start:dev"]
# Или напрямую: CMD ["nodemon", "--exec", "npm", "run", "start:dev"]