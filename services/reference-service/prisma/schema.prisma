generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id                  String    @id @default(uuid())
  nameRu              String    @map("name_ru") @db.VarChar(100)
  nameEn              String    @map("name_en") @db.VarChar(100)
  isoCode             String    @unique @map("iso_code") @db.VarChar(2)
  isoCode3            String    @unique @map("iso_code_3") @db.VarChar(3)
  numericCode         String?   @map("numeric_code") @db.VarChar(3)
  phoneCode           String    @map("phone_code") @db.VarChar(10)
  currencyCode        String    @map("currency_code") @db.VarChar(3)
  currencySymbol      String    @map("currency_symbol") @db.VarChar(10)
  timezone           String    @db.VarChar(50)
  flagEmoji          String    @map("flag_emoji") @db.VarChar(10)
  continent          String    @db.VarChar(50)
  capital            String?   @db.VarChar(100)
  languages          Json      @default("[]")
  isActive           Boolean   @map("is_active") @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  
  // Добавлено обратное отношение
  timezones          Timezone[]
  
  @@map("countries")
}

model Currency {
  id                  String    @id @default(uuid())
  code                String    @unique @db.VarChar(3)
  nameRu              String    @map("name_ru") @db.VarChar(100)
  nameEn              String    @map("name_en") @db.VarChar(100)
  symbol              String    @db.VarChar(10)
  symbolNative        String    @map("symbol_native") @db.VarChar(10)
  decimalDigits       Int       @map("decimal_digits") @default(2)
  rounding            Decimal   @db.Decimal(10, 2) @default(0)
  isActive            Boolean   @map("is_active") @default(true)
  exchangeRate        Decimal?  @map("exchange_rate") @db.Decimal(10, 6)
  isBaseCurrency      Boolean   @map("is_base_currency") @default(false)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  
  @@map("currencies")
}

model Timezone {
  id                  String    @id @default(uuid())
  name                String    @unique @db.VarChar(100)
  gmtOffset           String    @map("gmt_offset") @db.VarChar(10) // "+03:00"
  utcOffset           String    @map("utc_offset") @db.VarChar(10) // "UTC+3"
  isDst               Boolean   @map("is_dst") @default(false)
  countryId           String?   @map("country_id")
  countryCode         String?   @map("country_code") @db.VarChar(2)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  
  // Relations
  country             Country?  @relation(fields: [countryId], references: [id])
  
  @@map("timezones")
}

model SkillCategory {
  id                  String    @id @default(uuid())
  nameRu              String    @map("name_ru") @db.VarChar(100)
  nameEn              String    @map("name_en") @db.VarChar(100)
  descriptionRu       String?   @map("description_ru") @db.Text
  descriptionEn       String?   @map("description_en") @db.Text
  icon                String?   @db.VarChar(50)
  color               String?   @db.VarChar(7) // HEX color
  orderIndex          Int       @map("order_index") @default(0)
  isActive            Boolean   @map("is_active") @default(true)
  parentId            String?   @map("parent_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  
  // Relations
  parent              SkillCategory? @relation("ParentToChild", fields: [parentId], references: [id])
  children            SkillCategory[] @relation("ParentToChild")
  skills              Skill[]
  
  @@map("skill_categories")
}

model Skill {
  id                  String    @id @default(uuid())
  nameRu              String    @map("name_ru") @db.VarChar(100)
  nameEn              String    @map("name_en") @db.VarChar(100)
  descriptionRu       String?   @map("description_ru") @db.Text
  descriptionEn       String?   @map("description_en") @db.Text
  categoryId          String    @map("category_id")
  popularity          Int       @default(0)
  isVerified          Boolean   @map("is_verified") @default(false)
  synonyms            Json      @default("[]") // Alternative names
  metadata            Json      @default("{}")
  isActive            Boolean   @map("is_active") @default(true)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  
  // Relations
  category            SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@map("skills")
}

model Industry {
  id                  String    @id @default(uuid())
  nameRu              String    @map("name_ru") @db.VarChar(100)
  nameEn              String    @map("name_en") @db.VarChar(100)
  icon                String?   @db.VarChar(50)
  parentId            String?   @map("parent_id")
  orderIndex          Int       @map("order_index") @default(0)
  isActive            Boolean   @map("is_active") @default(true)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  
  // Relations
  parent              Industry? @relation("IndustryParent", fields: [parentId], references: [id])
  children            Industry[] @relation("IndustryParent")
  
  @@map("industries")
}

model ContractTemplate {
  id                  String    @id @default(uuid())
  name                String    @db.VarChar(255)
  type                String    @db.VarChar(50) // NDA, FREELANCE, EMPLOYMENT, PARTNERSHIP
  language            String    @db.VarChar(10) // ru, en
  content             String    @db.Text
  variables           Json      @default("[]") // ["client_name", "project_name", ...]
  isActive            Boolean   @map("is_active") @default(true)
  version             String    @default("1.0.0") @db.VarChar(20)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  
  @@map("contract_templates")
}

model LegalDocument {
  id                  String    @id @default(uuid())
  type                String    @db.VarChar(50) // TERMS, PRIVACY, COOKIES, GDPR, FAQ
  language            String    @db.VarChar(10) // ru, en
  version             String    @default("1.0.0") @db.VarChar(20)
  title               String    @db.VarChar(255)
  content             String    @db.Text
  isActive            Boolean   @map("is_active") @default(true)
  effectiveDate       DateTime  @map("effective_date")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  
  @@map("legal_documents")
}

model Language {
  id                  String    @id @default(uuid())
  code                String    @unique @db.VarChar(2) // ru, en, de, etc.
  nameNative          String    @map("name_native") @db.VarChar(100)
  nameEn              String    @map("name_en") @db.VarChar(100)
  isActive            Boolean   @map("is_active") @default(true)
  isDefault           Boolean   @map("is_default") @default(false)
  rtl                 Boolean   @default(false) // right-to-left
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  
  @@map("languages")
}

model TaskStatus {
  id                  String    @id @default(uuid())
  nameRu              String    @map("name_ru") @db.VarChar(50)
  nameEn              String    @map("name_en") @db.VarChar(50)
  color               String    @db.VarChar(7) // HEX color
  orderIndex          Int       @map("order_index") @default(0)
  type                String    @db.VarChar(20) // TODO, IN_PROGRESS, REVIEW, DONE
  isDefault           Boolean   @map("is_default") @default(false)
  isActive            Boolean   @map("is_active") @default(true)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  
  @@map("task_statuses")
}

model ProjectCategory {
  id                  String    @id @default(uuid())
  nameRu              String    @map("name_ru") @db.VarChar(100)
  nameEn              String    @map("name_en") @db.VarChar(100)
  icon                String?   @db.VarChar(50)
  parentId            String?   @map("parent_id")
  orderIndex          Int       @map("order_index") @default(0)
  isActive            Boolean   @map("is_active") @default(true)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  
  // Relations
  parent              ProjectCategory? @relation("CategoryParent", fields: [parentId], references: [id])
  children            ProjectCategory[] @relation("CategoryParent")
  
  @@map("project_categories")
}